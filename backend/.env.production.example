# ─── SERVER CONFIGURATION ────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://your-app.railway.app

# ─── DATABASE (Railway PostgreSQL) ───────────────────────────────────────────
DATABASE_URL=${{Postgres.DATABASE_URL}}

# ─── JWT SECRETS (CRITICAL: Generate strong random strings) ─────────────────
# Access Token Secret (minimum 32 characters) - Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_generated_jwt_secret_min_32_chars_here

# Refresh Token Secret (minimum 32 characters) - Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_REFRESH_SECRET=your_generated_refresh_secret_min_32_chars_here

# Token Expiry
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_EXPIRES_IN=7d

# ─── EMAIL (Gmail SMTP) ──────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=AutoMedic <noreply@automedic.mw>

# ─── GARAGE INFORMATION ──────────────────────────────────────────────────────
GARAGE_NAME=AutoMedic Garage
GARAGE_PHONE=+265 994 040 900
GARAGE_ADDRESS=Area 47, Lilongwe, Malawi
GARAGE_WHATSAPP=+265994040900
GARAGE_EMAIL=info@automedic.mw
GARAGE_HOURS=Mon–Sat: 7am – 6pm

# ─── CLOUDINARY (File Uploads - RECOMMENDED) ─────────────────────────────────
# Sign up at https://cloudinary.com (free tier available)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── FIREBASE ADMIN SDK (Customer Mobile Auth) ───────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_FULL_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── SENTRY (Error Tracking - OPTIONAL BUT RECOMMENDED) ──────────────────────
# Sign up at https://sentry.io
SENTRY_DSN=https://your-sentry-dsn@o123456.ingest.sentry.io/987654
