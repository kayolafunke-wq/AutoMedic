{
  "dev": {
    "driver": "pg",
    "host": {"ENV": "DATABASE_HOST"},
    "port": {"ENV": "DATABASE_PORT"},
    "database": {"ENV": "DATABASE_NAME"},
    "user": {"ENV": "DATABASE_USER"},
    "password": {"ENV": "DATABASE_PASSWORD"}
  },
  "production": {
    "driver": "pg",
    "connectionString": {"ENV": "DATABASE_URL"},
    "ssl": { "rejectUnauthorized": false }
  }
}
